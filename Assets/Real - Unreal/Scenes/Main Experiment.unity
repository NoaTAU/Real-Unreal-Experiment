    - target: {fileID: 1234312488749823225, guid: ee824579eadf66544a0c3913fec1debf,
        type: 3}
      propertyPath: m_text
      value: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05E2\u05D5\u05E0\u05D9\u05D9\u05E0\u05D9\u05DD
        \u05DC\u05D3\u05E2\u05EA \u05DE\u05D4 \u05D0\u05EA/\u05D4 \u05DE\u05E8\u05D2\u05D9\u05E9/\u05D4
        \u05DC\u05D2\u05D1\u05D9 \u05D4\u05D7\u05D5\u05D5\u05D9\u05D4 \u05E9\u05E2\u05D1\u05E8\u05EA
        \u05D6\u05D4 \u05E2\u05EA\u05D4 \u05D1'\u05E1\u05D1\u05D9\u05D1\u05D4 \u05D4\u05DE\u05D5\u05E6\u05D2\u05EA'.\n   
        \"\u05D4\u05DE\u05D5\u05E0\u05D7 '\u05E1\u05D1\u05D9\u05D1\u05D4 \u05DE\u05D5\u05E6\u05D2\u05EA'
        \u05DE\u05EA\u05D9\u05D9\u05D7\u05E1 \u05DB\u05D0\u05DF, \u05D5\u05DC\u05D0\u05D5\u05E8\u05DA
        \u05D4\u05E9\u05D0\u05DC\u05D5\u05DF \u05D4\u05D6\u05D4, \u05DC\u05E2\u05D5\u05DC\u05DD
        \u05D4\u05D5\u05D9\u05E8\u05D8\u05D5\u05D0\u05DC\u05D9 \u05E9\u05D4\u05EA\u05E0\u05E1\u05EA
        \u05D1\u05D5 \u05E2\u05DB\u05E9\u05D9\u05D5.\n    \u05D7\u05DC\u05E7 \u05DE\u05D4\u05E9\u05D0\u05DC\u05D5\u05EA
        \u05DE\u05EA\u05D9\u05D9\u05D7\u05E1\u05D5\u05EA \u05DC '\u05EA\u05D5\u05DB\u05DF'
        \u05E9\u05DC \u05D4\u05E1\u05D1\u05D9\u05D1\u05D4 \u05D4\u05DE\u05D5\u05E6\u05D2\u05EA.
        \u05D1\u05DB\u05DA \u05D0\u05E0\u05D5 \u05DE\u05EA\u05DB\u05D5\u05D5\u05E0\u05D9\u05DD
        \u05DC\u05E1\u05D9\u05E4\u05D5\u05E8, \u05DC\u05E1\u05E6\u05E0\u05D5\u05EA
        \u05D0\u05D5 \u05D0\u05D9\u05E8\u05D5\u05E2\u05D9\u05DD, \u05D0\u05D5 \u05DB\u05DC
        \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E8\u05D0\u05D5\u05EA,
        \u05DC\u05E9\u05DE\u05D5\u05E2 \u05D0\u05D5 \u05DC\u05D7\u05D5\u05E9 \u05E9\u05DE\u05EA\u05E8\u05D7\u05E9
        \u05D1\u05EA\u05D5\u05DA \u05D4\u05E1\u05D1\u05D9\u05D1\u05D4 \u05D4\u05DE\u05D5\u05E6\u05D2\u05EA.\n   
        \u05D4\u05E1\u05D1\u05D9\u05D1\u05D4 \u05D4\u05DE\u05D5\u05E6\u05D2\u05EA
        \u05D5\u05D4\u05EA\u05D5\u05DB\u05DF \u05E9\u05DC\u05D4 \u05E9\u05D5\u05E0\u05D9\u05DD
        \u05DE '\u05D4\u05E2\u05D5\u05DC\u05DD \u05D4\u05D0\u05DE\u05D9\u05EA\u05D9':
        \u05D4\u05E2\u05D5\u05DC\u05DD \u05E9\u05D1\u05D5 \u05D0\u05EA/\u05D4 \u05D7\u05D9/\u05D4
        \u05DE\u05D9\u05D5\u05DD \u05DC\u05D9\u05D5\u05DD.\n    \u05D9\u05E9\u05E0\u05DD
        \u05E9\u05E0\u05D9 \u05D7\u05DC\u05E7\u05D9\u05DD \u05DC\u05E9\u05D0\u05DC\u05D5\u05DF
        \u05D6\u05D4: \u05D7\u05DC\u05E7 \u05D0' \u05D5\u05D7\u05DC\u05E7 \u05D1'.
        \u05D7\u05DC\u05E7 \u05D0' \u05E9\u05D5\u05D0\u05DC \u05E2\u05DC \u05D4\u05DE\u05D7\u05E9\u05D1\u05D5\u05EA
        \u05D5\u05D4\u05E8\u05D2\u05E9\u05D5\u05EA \u05E9\u05DC\u05DA \u05D1\u05E8\u05D2\u05E2
        \u05E9\u05D4\u05E1\u05D1\u05D9\u05D1\u05D4 \u05D4\u05DE\u05D5\u05E6\u05D2\u05EA
        \u05D4\u05E1\u05EA\u05D9\u05D9\u05DE\u05D4.\n    \u05D7\u05DC\u05E7 \u05D1'
        \u05DE\u05EA\u05D9\u05D9\u05D7\u05E1 \u05DC\u05DE\u05D7\u05E9\u05D1\u05D5\u05EA
        \u05D5\u05DC\u05E8\u05D2\u05E9\u05D5\u05EA \u05E9\u05DC\u05DA \u05D1\u05D6\u05DE\u05DF
        \u05E9\u05D7\u05D5\u05D5\u05D9\u05EA \u05D0\u05EA \u05D4\u05E1\u05D1\u05D9\u05D1\u05D4
        \u05D4\u05DE\u05D5\u05E6\u05D2\u05EA.\n    \u05E0\u05D0 \u05DC\u05D0 \u05DC\u05D1\u05D6\u05D1\u05D6
        \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D3\u05D9 \u05D6\u05DE\u05DF \u05E2\u05DC
        \u05D0\u05E3 \u05E9\u05D0\u05DC\u05D4.\n    \u05D4\u05EA\u05D2\u05D5\u05D1\u05D4
        \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4 \u05E9\u05DC\u05DA \u05D4\u05D9\u05D0
        \u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC \u05D4\u05DB\u05D9 \u05D8\u05D5\u05D1\u05D4.
        \u05E2\u05D1\u05D5\u05E8 \u05DB\u05DC \u05E9\u05D0\u05DC\u05D4, \u05D1\u05D7\u05E8/\u05D9
        \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05D1\u05D4 \u05D4\u05E7\u05E8\u05D5\u05D1\u05D4
        \u05D1\u05D9\u05D5\u05EA\u05E8 \u05DC\u05E9\u05DC\u05DA.\n    \u05D0\u05E0\u05D0
        \u05D6\u05DB\u05D5\u05E8/\u05D9 \u05E9\u05D0\u05D9\u05DF \u05EA\u05E9\u05D5\u05D1\u05D5\u05EA
        \u05E0\u05DB\u05D5\u05E0\u05D5\u05EA \u05D0\u05D5 \u05DC\u05D0 \u05E0\u05DB\u05D5\u05E0\u05D5\u05EA
        - \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E4\u05E9\u05D5\u05D8 \u05DE\u05E2\u05D5\u05E0\u05D9\u05D9\u05E0\u05D9\u05DD
        \u05DC\u05D3\u05E2\u05EA \u05DE\u05D4 \u05D4\u05DE\u05D7\u05E9\u05D1\u05D5\u05EA
        \u05D5\u05D4\u05E8\u05D2\u05E9\u05D5\u05EA \u05E9\u05DC\u05DA \u05DC\u05D2\u05D1\u05D9
        \u05D4\u05E1\u05D1\u05D9\u05D1\u05D4 \u05D4\u05DE\u05D5\u05E6\u05D2\u05EA."
      objectReference: {fileID: 0}
