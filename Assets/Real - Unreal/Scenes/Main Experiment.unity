    - target: {fileID: 1234312488749823225, guid: ee824579eadf66544a0c3913fec1debf,
        type: 3}
      propertyPath: m_text
      value: "\u05D1\u05E0\u05D9\u05E1\u05D5\u05D9 \u05D6\u05D4 \u05D9\u05D5\u05E6\u05D2\u05D5
        \u05D1\u05E4\u05E0\u05D9\u05DA \u05D7\u05D8\u05D9\u05E4\u05D9\u05DD \u05E9\u05D5\u05E0\u05D9\u05DD
        \u05D1-3 \u05E1\u05D1\u05D1\u05D9\u05DD. \n\u05DB\u05DC \u05D7\u05D8\u05D9\u05E3
        \u05D9\u05D5\u05E6\u05D2 \u05DC\u05DE\u05E9\u05DA \u05DE\u05E1\u05E4\u05E8
        \u05E9\u05E0\u05D9\u05D5\u05EA \u05D5\u05DC\u05D0\u05D7\u05E8\u05D9\u05D4\u05DF
        \u05E0\u05D1\u05E7\u05E9 \u05DE\u05DE\u05DA \u05DC\u05D3\u05E8\u05D2 \u05DB\u05DE\u05D4
